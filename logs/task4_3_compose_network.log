
kay@mac$ cat .env
APP_NAME=SWE40006 Container Info
APP_ENV=local-compose
APP_VERSION=1.0.0
GREETING=Hello from Docker Compose on my Mac!
APP_OWNER=Khubi Shah
PORT=5000

kay@mac$ cat docker-compose.yml
# Task 4.3 - local run with a user-defined bridge network and env vars
services:
  web:
    build: .
    image: ${DOCKERHUB_USER:-khubi114}/swe40006-web:1.0
    container_name: swe40006-web
    env_file: .env
    ports:
      - "8080:5000"
    networks:
      - swe40006-net
    restart: unless-stopped

networks:
  swe40006-net:
    driver: bridge

